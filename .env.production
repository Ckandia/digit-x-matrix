NEXT_PUBLIC_DERIV_APP_ID=34o9mFaY1HjSSSXyE5DuL
# Numeric app_id for the classic-protocol trading WebSocket (wss://ws.derivws.com/websockets/v3).
# This is a DIFFERENT credential from NEXT_PUBLIC_DERIV_APP_ID above, which is
# the alphanumeric OAuth client ID used only for login. Register a numeric
# app_id at api.deriv.com and set it here before going live — this defaults to
# Deriv's shared public test id (1089), which is fine for a first smoke test
# but not for real use. See FIXES-AND-SETUP.md section 0.
NEXT_PUBLIC_DERIV_WS_APP_ID=1089
NEXT_PUBLIC_DERIV_APP_NAME=Digit X Matrix
NEXT_PUBLIC_DERIV_REFERRAL_LINK=https://t.deriv.link?t=D28Q98QP2NRM
NEXT_PUBLIC_DERIV_ENV=production
NEXT_PUBLIC_DERIV_OAUTH_SCOPES=trade
# Base URL of the Bulk Trader backend deployed on Render. Set this in Vercel's
# environment variables to your Render service URL, e.g.
# https://digit-x-matrix-backend.onrender.com (no trailing slash).
NEXT_PUBLIC_BULK_TRADER_API_URL=
# Optional: explicit WebSocket URL for the live digit-analysis feed that
# powers the Bulk Trades digit grid + signal banner. Leave unset to derive it
# automatically from NEXT_PUBLIC_BULK_TRADER_API_URL (http->ws, +/ws/signals).
NEXT_PUBLIC_ANALYSIS_WS_URL=