# Port Render assigns automatically — safe to leave unset in production.
PORT=4000

# Your Deriv app id (same one used by the frontend / registered in
# https://developers.deriv.com/dashboard/). Falls back to Deriv's public demo
# app id (1089) if unset, which works but won't carry your markup.
DERIV_APP_ID=34o9mFaY1HjSSSXyE5DuL

# Comma-separated list of origins allowed to call this backend. Set this to
# your Vercel deployment URL(s). Leave unset only for local development.
ALLOWED_ORIGIN=https://digit-x-matrix-carlos-githaes-projects.vercel.app

# Optional: Postgres connection string. Works with any Postgres, including
# Neon (https://neon.tech) — recommended: free tier, serverless, scales to
# zero. In the Neon console: Project → Connection Details → copy the
# "Pooled connection" string (starts with postgresql://...neon.tech/...).
# When unset, the backend runs fine with no run-history / signal-history persistence.
DATABASE_URL=

# Claude connector (read-only access to your trade journal). Both need 24+ / 16+ random characters.
# MCP_SECRET is the secret path of the connector URL:  https://<service>.onrender.com/mcp/<MCP_SECRET>
# JOURNAL_SYNC_KEY is what the app sends (Journal tab > Claude connector) to push trades to the backend.
MCP_SECRET=
JOURNAL_SYNC_KEY=
# Trades are kept this many hours (1-24; Deriv API Terms limit caching to 24h). Default 24.
JOURNAL_RETENTION_HOURS=24

# Server-side AI runner: the AI keeps trading when the browser is closed. Leave empty to keep it OFF.
# Any long random string; the app needs the same value (AI tab -> Runner key). RUNNER_MAX_HOURS ends a run by itself (default 24).
RUNNER_KEY=
RUNNER_MAX_HOURS=24
